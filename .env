# Project Aurum Environment Configuration
# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/project_aurum
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=project_aurum
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Market Data Configuration
ALPHA_VANTAGE_API_KEY=demo
YAHOO_FINANCE_ENABLED=true

# Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Telegram Configuration (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Indonesian Market Configuration
MARKET_TIMEZONE=Asia/Jakarta
MARKET_OPEN_TIME=09:00
MARKET_CLOSE_TIME=15:49

# Security Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ENABLED=true
RATE_LIMIT_ENABLED=true
SECURITY_ENABLED=true

# Monitoring
PROMETHEUS_ENABLED=false
METRICS_PORT=9090