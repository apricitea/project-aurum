# Frontend Standalone Mode Configuration
# Copy this to .env to run frontend without backend

# Mock Mode Settings
VITE_MOCK_MODE=true
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# App Settings
VITE_APP_TITLE="Project Aurum - Standalone Mode"
VITE_APP_DESCRIPTION="Indonesian Quantitative Trading System (Demo Mode)"

# Demo User Credentials (for mock login)
VITE_DEMO_USERNAME=demo
VITE_DEMO_PASSWORD=demo

# Feature Flags
VITE_REAL_TIME_UPDATES=true
VITE_MOCK_DATA_REFRESH_INTERVAL=5000
VITE_ENABLE_ANIMATIONS=true

# Display Settings
VITE_THEME=default
VITE_DARK_MODE=false

# Optional: Local development settings
VITE_DEV_TOOLS=true
VITE_DEBUG_MODE=false