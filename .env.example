# Indonesian Quantitative Trading Alert System Environment Configuration

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME="Indonesian Quantitative Trading Alert System"
VERSION=1.0.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project_aurum
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Indonesian Market Configuration
MARKET_TIMEZONE=Asia/Jakarta
MARKET_OPEN_TIME=09:00
MARKET_CLOSE_TIME=15:49
MARKET_LUNCH_START=12:00
MARKET_LUNCH_END=13:30

# ML Model Configuration
MODEL_PATH=models/idx_quant_model.pkl
MODEL_VERSION=1.0
AUTO_RETRAIN_ENABLED=true
RETRAIN_SCHEDULE="0 20 * * 0"

# Signal Generation
SIGNAL_GENERATION_TIME=08:30
AUTO_SIGNAL_GENERATION=true
SIGNAL_CONFIDENCE_THRESHOLD=0.6
MAX_DAILY_SIGNALS=50

# Risk Management
MAX_POSITION_SIZE=0.05
MAX_SECTOR_CONCENTRATION=0.25
MAX_PORTFOLIO_VOLATILITY=0.20
MAX_DRAWDOWN=0.15
RISK_CHECK_INTERVAL_MINUTES=5

# Email Notifications
EMAIL_ENABLED=false
EMAIL_CONFIG={"server":"smtp.gmail.com","port":587,"username":"your_email@gmail.com","password":"your_app_password","from_email":"your_email@gmail.com"}
DEFAULT_EMAIL_RECIPIENTS=trader1@company.com,trader2@company.com

# Telegram Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DEFAULT_TELEGRAM_CHATS=chat_id_1,chat_id_2

# SMS Notifications (Twilio)
SMS_ENABLED=false
TWILIO_CONFIG={"account_sid":"your_twilio_sid","auth_token":"your_twilio_token","from_number":"+1234567890"}
DEFAULT_SMS_NUMBERS=+6281234567890,+6287654321098

# Webhook Notifications
WEBHOOK_ENABLED=true
DEFAULT_WEBHOOK_URLS=https://hooks.slack.com/your_webhook_url

# Data Sources
IDX_DATA_ENABLED=true
IDX_API_KEY=your_idx_api_key
IDX_API_URL=https://api.idx.co.id

YAHOO_FINANCE_ENABLED=true
ALPHA_VANTAGE_ENABLED=false
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE=logs/trading_system.log
LOG_ROTATION=midnight
LOG_RETENTION=30

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
HEALTH_CHECK_INTERVAL=60

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=backups/

# Performance Settings
CACHE_TTL_SECONDS=300
API_RATE_LIMIT="100/minute"
MAX_CONCURRENT_REQUESTS=100

# Feature Flags
REAL_TIME_ALERTS=true
ADVANCED_ANALYTICS=true
MOBILE_NOTIFICATIONS=true
EXPORT_REPORTS=true

# Grafana Configuration (for monitoring)
GRAFANA_PASSWORD=admin123

# Development Settings (only for development environment)
# DEV_EMAIL_ENABLED=true
# DEV_TELEGRAM_ENABLED=true
# DEV_AUTO_CREATE_ADMIN=true
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=admin123
# DEV_ADMIN_EMAIL=admin@localhost

# Production Settings (only for production environment)
# PROD_SSL_ENABLED=true
# PROD_SSL_CERT_PATH=/etc/ssl/certs/trading.crt
# PROD_SSL_KEY_PATH=/etc/ssl/private/trading.key
# PROD_DOMAIN=trading.yourcompany.com