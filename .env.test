# Test Environment Configuration

ENVIRONMENT=test
DEBUG=false
APP_NAME="Indonesian Quantitative Trading Alert System - Test"
VERSION=1.0.0

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
ALLOWED_ORIGINS=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=test_db
DB_USER=test_user
DB_PASSWORD=test_password
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# JWT Configuration
JWT_SECRET_KEY=test_secret_key_for_testing_only
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=test_bot_token
WEB_APP_URL=http://localhost:3000

# Model Configuration
MODEL_PATH=models/test_model.pkl
MODEL_VERSION=1.0.0

# Feature Flags
ENABLE_ML_PREDICTIONS=false
ENABLE_ALERTS=false
ENABLE_TELEGRAM=false
